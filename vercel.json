{
  "headers": [
    { "source": "/fonts/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/images/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }] },
    { "source": "/(css|js)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=86400" }] }
  ],
  "rewrites": [
    { "source": "/product-detail-:slug.html", "destination": "/solution-reference.html" },
    { "source": "/project-highlight-:slug.html", "destination": "/project-highlight.html" },
    { "source": "/blog-:slug.html", "destination": "/blog-details.html" },
    { "source": "/webinar-:slug.html", "destination": "/webinar-details.html" },
    { "source": "/api/:path*", "destination": "https://cmsapi.qpaix.com/premierconcrete/api/:path*" },
    { "source": "/admin/:path*", "destination": "https://cmsapi.qpaix.com/premierconcrete/admin/:path*" }
  ]
}
